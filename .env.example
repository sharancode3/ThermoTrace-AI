# -----------------------------------------------------------------------------
# ThermoTrace AI - Global Environment Configuration
# -----------------------------------------------------------------------------

# PostgreSQL / PostGIS
POSTGRES_USER=thermo_admin
POSTGRES_PASSWORD=thermo_secret
POSTGRES_DB=thermo_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# FastAPI Backend
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=dev_secret_key_change_in_prod

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# External APIs
NASA_FIRMS_MAP_KEY=your_firms_map_key_here

FIRMS_MAP_KEY="your_actual_key_here"
